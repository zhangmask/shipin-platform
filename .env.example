# Shipin Platform Configuration
# Copy to .env and fill in your API keys

# OpenAI (for GPT-4o Vision review + Whisper)
OPENAI_API_KEY=sk-your-openai-key-here

# Image generation providers (at least one)
FLUX_API_KEY=sk-your-flux-key-here
# Or:
# OPENAI_IMAGE_API_KEY=sk-your-openai-image-key

# Video generation providers
SEEDANCE_API_KEY=sk-your-seedance-key-here
# Or:
# KLING_API_KEY=your-kling-key
# HUNYUAN_API_KEY=your-hunyuan-key

# TTS providers
ELEVENLABS_API_KEY=sk-your-elevenlabs-key
# Or:
# AZURE_TTS_KEY=your-azure-key
# AZURE_TTS_REGION=your-region

# Database (optional — platform works without it for CLI mode)
# DATABASE_URL=mysql://user:pass@localhost:3306/shipin
# REDIS_URL=redis://localhost:6379

# Platform
PLATFORM_WORK_DIR=./outputs
PLATFORM_MAX_ROUNDS=3
